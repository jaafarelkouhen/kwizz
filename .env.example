# Copier ce fichier en « .env » (même dossier) puis remplir. Le fichier .env n'est JAMAIS commité.
# Sans clé, Kwizz fonctionne normalement : les fonctions IA sont simplement masquées.

# Clé de l'API Claude (https://platform.claude.com) — à garder secrète
ANTHROPIC_API_KEY=

# auto = IA active si une clé est présente · oui = forcer · non = désactiver
KWIZZ_IA=auto

# Modèle Claude utilisé (laisser vide pour le modèle par défaut : claude-opus-5-5)
# Exemple moins cher pour des quizz simples : claude-haiku-5-5
KWIZZ_MODELE=
